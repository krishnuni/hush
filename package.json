{
  "name": "hush-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An original, local-first literary reader for desktop, with a portable mobile interface.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write src scripts tests *.ts *.json",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "voice:setup": "node scripts/setup-voice.mjs",
    "voice:build": "cargo build --release -p hush-voice-worker",
    "android": "tauri android dev",
    "ios": "tauri ios dev",
    "voice:stage": "node scripts/stage-desktop.mjs",
    "desktop:build:voice": "npm run voice:build && npm run voice:setup && npm run voice:stage && tauri build --config src-tauri/tauri.voice.conf.json",
    "test:offline": "playwright test --config playwright.offline.config.ts",
    "start": "node scripts/serve-preview.mjs",
    "prebuild": "node scripts/collect-licenses.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "dompurify": "^3.3.0",
    "epubjs": "0.3.93",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "epubjs": {
      "@xmldom/xmldom": "0.8.15"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "fake-indexeddb": "^6.2.0",
    "jsdom": "^28.0.0",
    "prettier": "3.9.10",
    "typescript": "^6.0.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
